{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Gateway": {
    "AdminKey": "",
    "RateLimits": {
      "RequestsPerMinute": 60,
      "TokensPerMinute": 100000,
      "DefaultMaxTokensEstimate": 1024
    },
    "Providers": {
      "openai": {
        "Type": "openai-compatible",
        "BaseUrl": "https://api.openai.com/v1",
        "ApiKey": "",
        "TimeoutSeconds": 120
      },
      "ollama": {
        "Type": "openai-compatible",
        "BaseUrl": "http://localhost:11434/v1",
        "TimeoutSeconds": 300
      },
      "mock": {
        "Type": "mock",
        "MockTokenDelayMs": 0
      }
    },
    "Models": {
      "gpt-4o-mini": {
        "Provider": "openai",
        "InputPricePerMTok": 0.15,
        "OutputPricePerMTok": 0.60
      },
      "gpt-4o": {
        "Provider": "openai",
        "InputPricePerMTok": 2.50,
        "OutputPricePerMTok": 10.00
      },
      "llama3.2": {
        "Provider": "ollama",
        "InputPricePerMTok": 0,
        "OutputPricePerMTok": 0
      },
      "mock-1": {
        "Provider": "mock",
        "InputPricePerMTok": 1.00,
        "OutputPricePerMTok": 2.00
      }
    }
  }
}
