{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Gateway": {
    "AdminKey": "",
    "RateLimits": {
      "RequestsPerMinute": 60,
      "TokensPerMinute": 100000,
      "DefaultMaxTokensEstimate": 1024
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "BreakSeconds": 30
    },
    "Cache": {
      "DefaultOn": false,
      "TtlSeconds": 3600,
      "SemanticEnabled": false,
      "SimilarityThreshold": 0.95,
      "MaxEntriesPerBucket": 500,
      "Embeddings": {
        "Provider": "mock",
        "Model": "text-embedding-3-small"
      }
    },
    "Budgets": {
      "DefaultMonthlyBudgetUsd": 0,
      "ReservationTtlSeconds": 600
    },
    "Providers": {
      "openai": {
        "Type": "openai-compatible",
        "BaseUrl": "https://api.openai.com/v1",
        "ApiKey": "",
        "TimeoutSeconds": 120
      },
      "anthropic": {
        "Type": "anthropic",
        "BaseUrl": "https://api.anthropic.com/v1",
        "ApiKey": "",
        "TimeoutSeconds": 300,
        "DefaultMaxTokens": 1024
      },
      "ollama": {
        "Type": "openai-compatible",
        "BaseUrl": "http://localhost:11434/v1",
        "TimeoutSeconds": 300
      },
      "mock": {
        "Type": "mock",
        "MockTokenDelayMs": 0
      },
      "mock-outage": {
        "Type": "mock",
        "MockFailWithStatus": 503
      }
    },
    "Models": {
      "gpt-4o-mini": {
        "Provider": "openai",
        "InputPricePerMTok": 0.15,
        "OutputPricePerMTok": 0.60
      },
      "gpt-4o": {
        "Provider": "openai",
        "InputPricePerMTok": 2.50,
        "OutputPricePerMTok": 10.00
      },
      "claude-sonnet-5-5": {
        "Provider": "anthropic",
        "InputPricePerMTok": 2.00,
        "OutputPricePerMTok": 10.00
      },
      "claude-haiku-5-5": {
        "Provider": "anthropic",
        "InputPricePerMTok": 0.10,
        "OutputPricePerMTok": 0.50
      },
      "llama3.2": {
        "Provider": "ollama",
        "InputPricePerMTok": 0,
        "OutputPricePerMTok": 0
      },
      "mock-1": {
        "Provider": "mock",
        "InputPricePerMTok": 1.00,
        "OutputPricePerMTok": 2.00
      },
      "mock-down": {
        "Provider": "mock-outage",
        "InputPricePerMTok": 1.00,
        "OutputPricePerMTok": 2.00,
        "Fallbacks": [ "mock-1" ]
      }
    }
  }
}
