<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LlmGateway</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.9.0-beta.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/schema.sql" LogicalName="schema.sql" />
    <EmbeddedResource Include="Limits/token_bucket.lua" LogicalName="token_bucket.lua" />
    <EmbeddedResource Include="Limits/token_refund.lua" LogicalName="token_refund.lua" />
    <EmbeddedResource Include="Limits/budget_reserve.lua" LogicalName="budget_reserve.lua" />
    <EmbeddedResource Include="Limits/budget_settle.lua" LogicalName="budget_settle.lua" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LlmGateway.Tests" />
  </ItemGroup>

</Project>
